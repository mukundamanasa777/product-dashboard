# Copy this file to .env for local dev, or set these as real environment
# variables on whatever platform you deploy to (do NOT commit a real .env).
#
# Both the `web` process (`npm run dev` / `npm start`) and the `worker`
# process (`npm run worker`) read from this same set of variables — the
# worker additionally needs DATABASE_URL and REDIS_URL to do anything.

# Postgres connection string used by Prisma at runtime (app queries).
# When pointed at a pooler (e.g. Supabase transaction pooler on :6543),
# add ?pgbouncer=true.
DATABASE_URL=postgresql://user:password@localhost:5432/product_dashboard
# Postgres connection used by the Prisma CLI (migrate/db push) — needs a
# session-capable connection, not a transaction-mode pooler. For local
# Postgres this is just the same URL as DATABASE_URL; for Supabase use the
# session pooler (:5432) or the true direct host.
DIRECT_URL=postgresql://user:password@localhost:5432/product_dashboard
# Redis connection string used by BullMQ (queues + the worker process).
REDIS_URL=redis://localhost:6379

# Optional. Routes both scraping fetch paths (request.ts's axios calls and
# browserRequest.ts's Playwright browser) through this proxy — needed when
# a manufacturer's site blocks datacenter/hosting-provider IP ranges
# wholesale (confirmed happening even with Railway's Static Outbound IPs
# enabled, since those are still datacenter IPs, just stable ones). Use a
# RESIDENTIAL proxy provider for this, not a datacenter one — a datacenter
# proxy hits the same wall. Format: http://username:password@host:port.
# Worker-only; the web process never scrapes, so it never needs this.
# SCRAPE_PROXY_URL=

# Queue dashboard (`npm run queue-dashboard`) — a Bull Board UI over the
# same queues the worker processes (http://localhost:4001/admin/queues by
# default). Runs as its own process; not required for `dev`/`worker`.
# QUEUE_DASHBOARD_PORT=4001
QUEUE_DASHBOARD_USER=admin
QUEUE_DASHBOARD_PASSWORD=

# Clerk authentication — see https://dashboard.clerk.com
# Use pk_test_/sk_test_ keys for local dev, pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
