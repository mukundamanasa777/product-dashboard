# Copy this file to .env for local dev, or set these as real environment
# variables on whatever platform you deploy to (do NOT commit a real .env).
#
# Both the `web` process (`npm run dev` / `npm start`) and the `worker`
# process (`npm run worker`) read from this same set of variables — the
# worker additionally needs DATABASE_URL and REDIS_URL to do anything.

# Postgres connection string used by Prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/product_dashboard

# Redis connection string used by BullMQ (queues + the worker process).
REDIS_URL=redis://localhost:6379

# Clerk authentication — see https://dashboard.clerk.com
# Use pk_test_/sk_test_ keys for local dev, pk_live_/sk_live_ in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
